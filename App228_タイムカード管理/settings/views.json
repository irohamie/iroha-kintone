      "html": "<style>\n/* ===== 訪問支援ダッシュボード スタイル ===== */\n#houmon-dashboard {\n    font-family: \"Hiragino Kaku Gothic ProN\", \"Meiryo\", sans-serif;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 16px;\n    color: #333;\n}\n\n/* 月ナビゲーション */\n.hd-month-nav {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n    margin: 8px 0 24px 0;\n}\n.hd-month-nav button {\n    font-size: 22px;\n    padding: 8px 20px;\n    border: 1px solid #b0b0b0;\n    border-radius: 6px;\n    background: #fff;\n    color: #333;\n    cursor: pointer;\n    min-width: 50px;\n    min-height: 44px;\n    -webkit-tap-highlight-color: rgba(0,0,0,0.1);\n}\n.hd-month-nav button:active {\n    background: #e8e8e8;\n}\n.hd-month-label {\n    font-size: 22px;\n    font-weight: bold;\n    min-width: 160px;\n    text-align: center;\n}\n\n/* セクション見出し */\n.hd-section-title {\n    font-size: 17px;\n    font-weight: bold;\n    margin: 28px 0 8px 0;\n    padding: 8px 14px;\n    border-left: 4px solid #4a90d9;\n    background: #f0f5fb;\n    border-radius: 0 4px 4px 0;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n.hd-section-title.kaigi {\n    border-left-color: #d9944a;\n    background: #fdf5ed;\n}\n.hd-badge {\n    font-size: 12px;\n    font-weight: normal;\n    padding: 2px 8px;\n    border-radius: 10px;\n    background: rgba(0,0,0,0.08);\n    color: #666;\n}\n\n/* テーブル共通 */\n.hd-table-wrap {\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    margin-bottom: 8px;\n}\n.hd-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 14px;\n    min-width: 500px;\n}\n.hd-table th {\n    background: #f7f7f7;\n    border: 1px solid #ddd;\n    padding: 8px 10px;\n    text-align: left;\n    font-weight: bold;\n    white-space: nowrap;\n    position: sticky;\n    top: 0;\n    z-index: 1;\n}\n.hd-table td {\n    border: 1px solid #ddd;\n    padding: 7px 10px;\n    vertical-align: top;\n}\n.hd-table tbody tr:nth-child(even) {\n    background: #fafbfc;\n}\n.hd-table tbody tr:hover {\n    background: #eef3fa;\n}\n\n/* 会議日付セル */\n.hd-kaigi-date {\n    color: #4a6fa5;\n    font-weight: bold;\n    white-space: nowrap;\n}\n\n/* 初回セル */\n.hd-first-cell {\n    text-align: center;\n    color: #d35400;\n    font-weight: bold;\n    font-size: 12px;\n}\n\n/* レコードリンクセル */\n.hd-link-cell {\n    text-align: center;\n}\n.hd-rec-link {\n    display: inline-block;\n    padding: 3px 10px;\n    font-size: 12px;\n    color: #fff;\n    background: #4a90d9;\n    border-radius: 4px;\n    text-decoration: none;\n    white-space: nowrap;\n}\n.hd-rec-link:active {\n    background: #3a7bc0;\n}\n\n/* ローディング・エラー */\n.hd-loading {\n    text-align: center;\n    padding: 60px 20px;\n    color: #888;\n    font-size: 16px;\n}\n.hd-error {\n    color: #c00;\n    padding: 20px;\n    background: #fff0f0;\n    border: 1px solid #fcc;\n    border-radius: 6px;\n    margin: 20px 0;\n}\n.hd-empty {\n    color: #999;\n    padding: 12px;\n    text-align: center;\n    font-size: 13px;\n}\n</style>\n<div id=\"houmon-dashboard\">\n    <div class=\"hd-loading\">読み込み中...</div>\n</div>",
